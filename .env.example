# Copy to .env before running docker compose. Compose substitutes these into
# docker-compose.yml — the backend REFUSES TO START if the two required ones
# are missing, which is deliberate (see backend/src/config/env.js).

# REQUIRED — AES-256-GCM key for admin TOTP secrets at rest. 32 bytes as hex.
#   Generate: openssl rand -hex 32
ENCRYPTION_KEY=

# REQUIRED — API prefix for the admin panel. Obscurity only, never the real
# defence (that is password + TOTP + RLS). Any URL-safe word works.
ADMIN_SECRET_PATH=

# Optional — Google sign-in. Leave blank to disable the Google button.
GOOGLE_CLIENT_ID=
GOOGLE_SECRET_KEY=

# Optional — Pandit Ji AI chat. Without it the chat endpoint returns an error
# and the rest of the site is unaffected.
OPENAI_API_KEY=

# Optional — Razorpay test-mode keys. Without them POST /pandits/:id/subscribe
# returns 501 rather than pretending to charge anyone.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Google Maps / Places — powers the admin temple location picker.
GOOGLE_MAPS_API_KEY=
