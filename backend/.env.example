# Copy to .env for local (non-Docker) runs. Docker Compose sets these itself
# (see docker-compose.yml — the backend service gets DATABASE_URL pointing at
# the "db" container over the compose network, not this file).
PORT=4000
NODE_ENV=development

# Points at the "db" service's port mapped to the host — see docker-compose.yml
# (only needed if you run the backend directly with `npm run dev`, against a
# Postgres started via `docker compose up -d db`).
# Connects as panditconnect_app (created by 01-schema.sql), NOT the bootstrap
# "panditconnect" superuser — Row-Level Security policies don't apply to the
# table owner, so the app must connect as a different, unprivileged role.
DATABASE_URL=postgresql://panditconnect_app:panditconnect_app_dev@localhost:5433/panditconnect

# Comma-separated list of origins allowed to call this API. In Docker Compose
# the frontend is reverse-proxied through nginx (same-origin), so this is
# only needed when running the frontend and backend as separate origins
# (e.g. frontend on :8080, backend on :4000, without the nginx proxy).
CORS_ORIGIN=http://localhost:8080

# How long an issued session bearer token stays valid before /auth/login must
# be called again.
SESSION_TTL_HOURS=720

# Razorpay test-mode keys for the subscription/payment endpoints
# (POST /api/pandits/:id/subscribe, POST /api/payments/webhook). Leave blank
# to run everything else; those two routes 501 until real test keys are set —
# see README "Known placeholders".
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# 32 random bytes, hex (64 chars) — AES-256-GCM key for the one field that
# needs reversible encryption rather than a one-way hash: an admin's TOTP
# secret at rest (backend/src/utils/crypto.js). Generate your own with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Changing this invalidates every admin's existing TOTP secret.
ENCRYPTION_KEY=1001480ac2400463a4eadd40a3f49b4f68534e13470a319e0f2a071f0327405a

# Where the admin panel is mounted under /api/ — obscurity only, not real
# access control (that's TOTP + Row-Level Security). See docs/ADMIN.md.
ADMIN_SECRET_PATH=ambitious-person
