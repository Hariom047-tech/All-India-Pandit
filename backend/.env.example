# Copy to .env for local (non-Docker) runs. Docker Compose sets these itself
# (see docker-compose.yml — the backend service gets DATABASE_URL pointing at
# the "db" container over the compose network, not this file).
PORT=4000
NODE_ENV=development

# Points at the "db" service's port mapped to the host — see docker-compose.yml
# (only needed if you run the backend directly with `npm run dev`, against a
# Postgres started via `docker compose up -d db`).
# Connects as panditconnect_app (created by 01-schema.sql), NOT the bootstrap
# "panditconnect" superuser — Row-Level Security policies don't apply to the
# table owner, so the app must connect as a different, unprivileged role.
DATABASE_URL=postgresql://panditconnect_app:panditconnect_app_dev@localhost:5433/panditconnect

# Comma-separated list of origins allowed to call this API. In Docker Compose
# the frontend is reverse-proxied through nginx (same-origin), so this is
# only needed when running the frontend and backend as separate origins
# (e.g. frontend on :8080, backend on :4000, without the nginx proxy).
CORS_ORIGIN=http://localhost:8080

# How long an issued session bearer token stays valid before /auth/login must
# be called again.
SESSION_TTL_HOURS=720

# Razorpay test-mode keys for the subscription/payment endpoints
# (POST /api/pandits/:id/subscribe, POST /api/payments/webhook). Leave blank
# to run everything else; those two routes 501 until real test keys are set —
# see README "Known placeholders".
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# 32 random bytes, hex (64 chars) — AES-256-GCM key for the one field that
# needs reversible encryption rather than a one-way hash: an admin's TOTP
# secret at rest (backend/src/utils/crypto.js). Generate your own with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Changing this invalidates every admin's existing TOTP secret.
ENCRYPTION_KEY=<replace-with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))">

# Where the admin panel is mounted under /api/ — obscurity only, not real
# access control (that's TOTP + Row-Level Security). The frontend's
# VITE_ADMIN_SECRET_PATH (frontend/Dockerfile) must match this exactly —
# it also gates the browser route to the admin panel itself. See docs/ADMIN.md.
ADMIN_SECRET_PATH=ambitiousperson

# Absolute origin used to build <loc> URLs in the dynamic sitemap
# (routes/sitemap.routes.js). Mirrors frontend/app/src/lib/siteConfig.ts's
# own fallback, so leave unset unless this deployment's real domain differs
# from https://panditsuggest.com.
PUBLIC_SITE_URL=https://panditsuggest.com

# ── Local geo testing (development only) ────────────────────────────────────
# On localhost there is no CDN, so no country header, so the market is always
# UNKNOWN — and the exposure endpoint refuses to record against an unknown
# market by design. That makes it look like the fairness engine is broken when
# it is not. Set this to 1 to enable an X-Dev-Country header for local testing:
#
#   ALLOW_DEV_GEO_HEADER=1 npm run dev
#   curl -H 'X-Dev-Country: US' localhost:4000/api/pandits/distribution-order
#
# Ignored entirely when NODE_ENV=production. Leave unset on any deployed
# environment — it decides which pandits a visitor sees.
ALLOW_DEV_GEO_HEADER=

# Same purpose, without a header — set once and every request on this server
# resolves to that market, instead of adding X-Dev-Country to every curl call.
# The header above still wins if both are set. Also ignored when
# NODE_ENV=production, independently of ALLOW_DEV_GEO_HEADER.
#   DEV_COUNTRY_OVERRIDE=IN   → INDIA on every request
#   DEV_COUNTRY_OVERRIDE=US   → INTERNATIONAL
#   DEV_COUNTRY_OVERRIDE=     → UNKNOWN (the honest local-dev default)
DEV_COUNTRY_OVERRIDE=

# ── Local OTP testing (development only) ────────────────────────────────────
# No real SMS/email provider is wired up (see README "Known placeholders"), so
# there is no way to receive a real OTP outside of NODE_ENV=development's
# console log. Set this to a fixed code (e.g. 1234) to also accept it for ANY
# pending OTP — phone or email, POST /auth/otp/verify and POST /auth/otp/login
# alike — so signup/login can be tested end-to-end without a provider.
#
# Deliberately NOT gated on NODE_ENV like ALLOW_DEV_GEO_HEADER: this repo's
# own local Docker Compose rig runs with NODE_ENV=production (see
# docker-compose.yml), so a NODE_ENV-based gate would make this impossible to
# turn on there. The env var being unset is the ONLY gate — leave this unset
# on any real deployment, since setting it lets anyone sign in as anyone by
# typing this code instead of the real OTP.
OTP_TEST_BYPASS_CODE=

# ── Production geo (CloudFront-ready) ───────────────────────────────────────
# GEO_PROVIDER is documentation of intent for whoever reads this file next —
# the resolver itself (services/distribution/market.js) is vendor-agnostic
# and does not branch on it; CloudFront, Cloudflare, App Engine and Vercel's
# country headers are all recognised out of the box with zero configuration.
#
# GEO_COUNTRY_HEADER adds ONE more trusted header (tried first, ahead of the
# built-in vendor list) without a code change — for a load balancer or a CDN
# not already in that list. Leave unset if CloudFront's own header is enough.
#
# TRUST_CDN_GEO=false is the kill switch: disables every edge header source
# at once (every visitor resolves to UNKNOWN) for a deployment that is not
# yet sure its origin cannot be reached directly, bypassing the CDN — see the
# docker-compose.yml note on the backend service's port binding. Prefer
# fixing the origin exposure over leaving this set to false permanently.
GEO_PROVIDER=cloudfront
GEO_COUNTRY_HEADER=
TRUST_CDN_GEO=true

# Infrastructure automation only (Terraform/CDK/deploy scripts creating or
# updating the CloudFront distribution itself) — NOT read by the running
# application. Country resolution at request time depends on the trusted
# header above, never on calling AWS APIs per-visitor. Leave unset unless
# such automation actually exists in this deployment; never hardcode real
# values here.
# AWS_REGION=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
